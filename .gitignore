# Generated by scripts/build_blog.py from blog/*.md. The Markdown is the
# source; this output is rebuilt in the Docker builder stage on every deploy.
site/blog/

# Compiled from site/scripts/run-experience.jsx by the jsx builder stage.
# The .jsx is the source of truth.
site/scripts/run-experience.js

# React production UMD builds, copied out of node_modules by
# scripts/vendor-react.js during the build.
site/vendor/

node_modules/

# Local tooling, machine-specific (absolute paths from a dev home dir).
.claude/settings.local.json
.impeccable/
